{
  "name": "react-ts-custom-hooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "audit": "npm audit --audit-level=high",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npm run build && node scripts/record-demo.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "18.2.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.12.0",
    "@types/react": "18.2.16",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "gifenc": "1.0.3",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "typescript": "5.1.6",
    "vite": "8.3.1",
    "vitest": "5.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "description": "A personal task and focus workspace built with reusable React and TypeScript hooks.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
